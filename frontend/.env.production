# Production API URL for the Android APK.
# This value is baked into the Capacitor/Vite bundle at build time.
#
# REPLACE THIS PLACEHOLDER with your actual Render backend URL before building the APK.
# Example: VITE_API_BASE_URL=https://smartagri-backend.onrender.com/api
#
# DO NOT use ngrok URLs here — they expire and change.
# DO NOT use localhost — Android devices cannot reach your laptop.
VITE_API_BASE_URL=https://smartagri-o2gw.onrender.com/api

# Direct AI Service URL — the Android APK calls the AI service directly for predictions.
# This bypasses the backend proxy (/api/predict → proxy → AI service) which was
# causing 404 errors when AI_SERVICE_URL was not correctly set on the Render backend.
# The AI service is at: https://smartagri-ai-78su.onrender.com
# Its predict endpoint is: POST /predict/plant-disease
VITE_AI_SERVICE_URL=https://smartagri-ai-78su.onrender.com
